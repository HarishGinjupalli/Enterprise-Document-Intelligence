# Application
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Frontend
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=edi_user
DB_PASSWORD=edi_password
DB_NAME=enterprise_doc_intelligence
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=24h

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# AI Providers (leave empty for mock/dev providers)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# Vector Store
VECTOR_STORE_TYPE=memory
# For production: qdrant, pinecone, etc.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=edi_chunks

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:5173
